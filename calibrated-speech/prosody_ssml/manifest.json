wer": "she", "strategy": "emphasis", "targets": ["she"], "expected": "stress", "m": "prosody_ssml/CS2-41-CS1-01_m.mp3", "f": "prosody_ssml/CS2-41-CS1-01_f.mp3"}, "CS2-41-CS1-02": {"text": "I didn't SAY she stole the money.", "type": "contrastive_stress", "answer": "say", "strategy": "emphasis", "targets": ["say"], "expected": "stress", "m": "prosody_ssml/CS2-41-CS1-02_m.mp3", "f": "prosody_ssml/CS2-41-CS1-02_f.mp3"}, "CS2-41-CS1-03": {"text": "I didn't say she STOLE the money.", "type": "contrastive_stress", "answer": "stole", "strategy": "emphasis", "targets": ["stole"], "expected": "stress", "m": "prosody_ssml/CS2-41-CS1-03_m.mp3", "f": "prosody_ssml/CS2-41-CS1-03_f.mp3"}, "CS2-41-CS1-04": {"text": "I didn't say she stole the MONEY.", "type": "contrastive_stress", "answer": "money", "strategy": "emphasis", "targets": ["money"], "expected": "stress", "m": "prosody_ssml/CS2-41-CS1-04_m.mp3", "f": "prosody_ssml/CS2-41-CS1-04_f.mp3"}, "CS2-41-CS1-05": {"text": "I DIDN'T say she stole the money.", "type": "contrastive_stress", "answer": "didnt", "strategy": "emphasis", "targets": ["didn't"], "expected": "stress", "m": "prosody_ssml/CS2-41-CS1-05_m.mp3", "f": "prosody_ssml/CS2-41-CS1-05_f.mp3"}, "CS2-41-CS2-01": {"text": "I want the RED one, not the blue one.", "type": "contrastive_stress", "answer": "red", "strategy": "emphasis", "targets": ["red"], "expected": "stress", "m": "prosody_ssml/CS2-41-CS2-01_m.mp3", "f": "prosody_ssml/CS2-41-CS2-01_f.mp3"}, "CS2-41-CS2-02": {"text": "No, it's on THURSday.", "type": "contrastive_stress", "answer": "thursday", "strategy": "emphasis", "targets": ["thursday"], "expected": "stress", "m": "prosody_ssml/CS2-41-CS2-02_m.mp3", "f": "prosody_ssml/CS2-41-CS2-02_f.mp3"}, "CS2-41-CS2-03": {"text": "Give it to HIM, not to her.", "type": "contrastive_stress", "answer": "him", "strategy": "emphasis", "targets": ["him"], "expected": "stress", "m": "prosody_ssml/CS2-41-CS2-03_m.mp3", "f": "prosody_ssml/CS2-41-CS2-03_f.mp3"}, "CS2-41-CS2-04":