{"CS2-23-CS1-01": {"text": "They built a GREENhouse in the garden.", "type": "contrastive_stress", "answer": "compound", "strategy": "emphasis", "targets": ["greenhouse"], "expected": "stress", "m": "prosody_ssml/CS2-23-CS1-01_m.mp3", "f": "prosody_ssml/CS2-23-CS1-01_f.mp3"}, "CS2-23-CS1-02": {"text": "They live in a green HOUSE on the corner.", "type": "contrastive_stress", "answer": "phrase", "strategy": "emphasis", "targets": ["house"], "expected": "stress", "m": "prosody_ssml/CS2-23-CS1-02_m.mp3", "f": "prosody_ssml/CS2-23-CS1-02_f.mp3"}, "CS2-23-CS2-01": {"text": "She works at the WHITE House.", "type": "contrastive_stress", "answer": "compound", "strategy": "emphasis", "targets": ["white"], "expected": "stress", "m": "prosody_ssml/CS2-23-CS2-01_m.mp3", "f": "prosody_ssml/CS2-23-CS2-01_f.mp3"}, "CS2-23-CS2-02": {"text": "She lives in a white HOUSE.", "type": "contrastive_stress", "answer": "phrase", "strategy": "emphasis", "targets": ["house"], "expected": "stress", "m": "prosody_ssml/CS2-23-CS2-02_m.mp3", "f": "prosody_ssml/CS2-23-CS2-02_f.mp3"}, "CS2-23-CS3-01": {"text": "Write it on the BLACKboard.", "type": "contrastive_stress", "answer": "compound", "strategy": "emphasis", "targets": ["blackboard"], "expected": "stress", "m": "prosody_ssml/CS2-23-CS3-01_m.mp3", "f": "prosody_ssml/CS2-23-CS3-01_f.mp3"}, "CS2-23-CS3-02": {"text": "Write it on the black BOARD.", "type": "contrastive_stress", "answer": "phrase", "strategy": "emphasis", "targets": ["board"], "expected": "stress", "m": "prosody_ssml/CS2-23-CS3-02_m.mp3", "f": "prosody_ssml/CS2-23-CS3-02_f.mp3"}, "CS2-23-CS4-01": {"text": "He is an ENGlish teacher.", "type": "contrastive_stress", "answer": "compound", "strategy": "emphasis", "targets": ["english"], "expected": "stress", "m": "prosody_ssml/CS2-23-CS4-01_m.mp3", "f": "prosody_ssml/CS2-23-CS4-01_f.mp3"}, "CS2-23-CS4-02": {"text": "He is an English TEACHer.", "type": "contrastive_stress", "answer": "phrase", "strategy": "emphasis", "targets": ["teacher"], "expected": "stress", "m": "prosody_ssml/CS2-23-CS4-02_m.mp3", "f": "prosody_ssml/CS2-23-CS4-02_f.mp3"}, "CS2-23-CS5-01": {"text": "I ordered a HOT dog.", "type": "contrastive_stress", "answer": "compound", "strategy": "emphasis", "targets": ["hot"], "expected": "stress", "m": "prosody_ssml/CS2-23-CS5-01_m.mp3", "f": "prosody_ssml/CS2-23-CS5-01_f.mp3"}, "CS2-23-CS5-02": {"text": "I ordered a hot DOG.", "type": "contrastive_stress", "answer": "phrase", "strategy": "emphasis", "targets": ["dog"], "expected": "stress", "m": "prosody_ssml/CS2-23-CS5-02_m.mp3", "f": "prosody_ssml/CS2-23-CS5-02_f.mp3"}, "CS2-23-CS6-01": {"text": "We met in the DARKroom.", "type": "contrastive_stress", "answer": "compound", "strategy": "emphasis", "targets": ["darkroom"], "expected": "stress", "m": "prosody_ssml/CS2-23-CS6-01_m.mp3", "f": "prosody_ssml/CS2-23-CS6-01_f.mp3"}, "CS2-23-CS6-02": {"text": "We met in the dark ROOM.", "type": "contrastive_stress", "answer": "phrase", "strategy": "emphasis", "targets": ["room"], "expected": "stress", "m": "prosody_ssml/CS2-23-CS6-02_m.mp3", "f": "prosody_ssml/CS2-23-CS6-02_f.mp3"}, "CS2-25-P1-01": {"text": "Please turn it OFF.", "type": "prosody", "answer": "particle", "strategy": "emphasis", "targets": ["off"], "expected": "stress", "m": "prosody_ssml/CS2-25-P1-01_m.mp3", "f": "prosody_ssml/CS2-25-P1-01_f.mp3"}, "CS2-25-P1-02": {"text": "Could you look it UP?", "type": "prosody", "answer": "particle", "strategy": "emphasis", "targets": ["up"], "expected": "stress", "m": "prosody_ssml/CS2-25-P1-02_m.mp3", "f": "prosody_ssml/CS2-25-P1-02_f.mp3"}, "CS2-25-P1-03": {"text": "I will pick you UP at eight.", "type": "prosody", "answer": "particle", "strategy": "emphasis", "targets": ["up"], "expected": "stress", "m": "prosody_ssml/CS2-25-P1-03_m.mp3", "f": "prosody_ssml/CS2-25-P1-03_f.mp3"}, "CS2-25-P1-04": {"text": "She turned the offer DOWN.", "type": "prosody", "answer": "particle", "strategy": "emphasis", "targets": ["down"], "expected": "stress", "m": "prosody_ssml/CS2-25-P1-04_m.mp3", "f": "prosody_ssml/CS2-25-P1-04_f.mp3"}, "CS2-25-P1-05": {"text": "We need to sort this OUT.", "type": "prosody", "answer": "particle", "strategy": "emphasis", "targets": ["out"], "expected": "stress", "m": "prosody_ssml/CS2-25-P1-05_m.mp3", "f": "prosody_ssml/CS2-25-P1-05_f.mp3"}, "CS2-25-P2-01": {"text": "She looked at the REport.", "type": "prosody", "answer": "preposition", "strategy": "emphasis", "targets": ["report"], "expected": "stress", "m": "prosody_ssml/CS2-25-P2-01_m.mp3", "f": "prosody_ssml/CS2-25-P2-01_f.mp3"}, "CS2-25-P2-02": {"text": "He listened to the CLIent.", "type": "prosody", "answer": "preposition", "strategy": "emphasis", "targets": ["client"], "expected": "stress", "m": "prosody_ssml/CS2-25-P2-02_m.mp3", "f": "prosody_ssml/CS2-25-P2-02_f.mp3"}, "CS2-25-P2-03": {"text": "They agreed with the DEcision.", "type": "prosody", "answer": "preposition", "strategy": "emphasis", "targets": ["decision"], "expected": "stress", "m": "prosody_ssml/CS2-25-P2-03_m.mp3", "f": "prosody_ssml/CS2-25-P2-03_f.mp3"}, "CS2-28-P1-01": {"text": "I NEED to GO to the STORE.", "type": "prosody", "answer": "content-strong", "strategy": "emphasis", "targets": ["need", "go", "store"], "expected": "stress", "m": "prosody_ssml/CS2-28-P1-01_m.mp3", "f": "prosody_ssml/CS2-28-P1-01_f.mp3"}, "CS2-28-P1-02": {"text": "She is the BEST in the CLASS.", "type": "prosody", "answer": "content-strong", "strategy": "emphasis", "targets": ["best", "class"], "expected": "stress", "m": "prosody_ssml/CS2-28-P1-02_m.mp3", "f": "prosody_ssml/CS2-28-P1-02_f.mp3"}, "CS2-28-P1-03": {"text": "We had a CUP of COFfee.", "type": "prosody", "answer": "content-strong", "strategy": "emphasis", "targets": ["cup", "coffee"], "expected": "stress", "m": "prosody_ssml/CS2-28-P1-03_m.mp3", "f": "prosody_ssml/CS2-28-P1-03_f.mp3"}, "CS2-28-P1-04": {"text": "I WANT to TALK to the MANager.", "type": "prosody", "answer": "content-strong", "strategy": "emphasis", "targets": ["want", "talk", "manager"], "expected": "stress", "m": "prosody_ssml/CS2-28-P1-04_m.mp3", "f": "prosody_ssml/CS2-28-P1-04_f.mp3"}, "CS2-31-TG1-01": {"text": "When the report is finished... send it to the whole team... not just to me.", "type": "thought_group", "answer": "three-groups", "strategy": "breaks", "targets": [], "expected": "breaks", "m": "prosody_ssml/CS2-31-TG1-01_m.mp3", "f": "prosody_ssml/CS2-31-TG1-01_f.mp3"}, "CS2-31-TG1-02": {"text": "When the report is finished send it to the whole team not just to me.", "type": "thought_group", "answer": "no-groups", "strategy": "plain", "targets": [], "expected": "plain", "m": "prosody_ssml/CS2-31-TG1-02_m.mp3", "f": "prosody_ssml/CS2-31-TG1-02_f.mp3"}, "CS2-31-TG2-01": {"text": "My brother... who works in Milan... is arriving on Thursday.", "type": "thought_group", "answer": "three-groups", "strategy": "breaks", "targets": [], "expected": "breaks", "m": "prosody_ssml/CS2-31-TG2-01_m.mp3", "f": "prosody_ssml/CS2-31-TG2-01_f.mp3"}, "CS2-31-TG2-02": {"text": "My brother who works in Milan is arriving on Thursday.", "type": "thought_group", "answer": "no-groups", "strategy": "plain", "targets": [], "expected": "plain", "m": "prosody_ssml/CS2-31-TG2-02_m.mp3", "f": "prosody_ssml/CS2-31-TG2-02_f.mp3"}, "CS2-31-TG3-01": {"text": "We can start the project... but only after the budget is approved.", "type": "thought_group", "answer": "two-groups", "strategy": "breaks", "targets": [], "expected": "breaks", "m": "prosody_ssml/CS2-31-TG3-01_m.mp3", "f": "prosody_ssml/CS2-31-TG3-01_f.mp3"}, "CS2-31-TG4-01": {"text": "Thank you all for coming... I want to cover three things today... the timeline... the budget... and the risks.", "type": "thought_group", "answer": "five-groups", "strategy": "breaks", "targets": [], "expected": "breaks", "m": "prosody_ssml/CS2-31-TG4-01_m.mp3", "f": "prosody_ssml/CS2-31-TG4-01_f.mp3"}, "CS2-32-P1-01": {"text": "DOGS EAT BONES.", "type": "prosody", "answer": "three-beats", "strategy": "emphasis", "targets": ["dogs", "eat", "bones"], "expected": "stress", "m": "prosody_ssml/CS2-32-P1-01_m.mp3", "f": "prosody_ssml/CS2-32-P1-01_f.mp3"}, "CS2-32-P1-02": {"text": "The DOGS have EATen the BONES.", "type": "prosody", "answer": "three-beats", "strategy": "emphasis", "targets": ["dogs", "eaten", "bones"], "expected": "stress", "m": "prosody_ssml/CS2-32-P1-02_m.mp3", "f": "prosody_ssml/CS2-32-P1-02_f.mp3"}, "CS2-32-P1-03": {"text": "The CAT sat on the MAT.", "type": "prosody", "answer": "two-beats", "strategy": "emphasis", "targets": ["cat", "mat"], "expected": "stress", "m": "prosody_ssml/CS2-32-P1-03_m.mp3", "f": "prosody_ssml/CS2-32-P1-03_f.mp3"}, "CS2-32-P1-04": {"text": "The CAT has been SITting on the MAT.", "type": "prosody", "answer": "two-beats", "strategy": "emphasis", "targets": ["cat", "sitting", "mat"], "expected": "stress", "m": "prosody_ssml/CS2-32-P1-04_m.mp3", "f": "prosody_ssml/CS2-32-P1-04_f.mp3"}, "CS2-32-P1-05": {"text": "BIRDS SING.", "type": "prosody", "answer": "two-beats", "strategy": "emphasis", "targets": ["birds", "sing"], "expected": "stress", "m": "prosody_ssml/CS2-32-P1-05_m.mp3", "f": "prosody_ssml/CS2-32-P1-05_f.mp3"}, "CS2-32-P1-06": {"text": "The BIRDS have been SINGing.", "type": "prosody", "answer": "two-beats", "strategy": "emphasis", "targets": ["birds", "singing"], "expected": "stress", "m": "prosody_ssml/CS2-32-P1-06_m.mp3", "f": "prosody_ssml/CS2-32-P1-06_f.mp3"}, "CS2-32-P2-01": {"text": "I NEED to FInish the REport toDAY.", "type": "prosody", "answer": "four-beats", "strategy": "emphasis", "targets": ["need", "finish", "report", "today"], "expected": "stress", "m": "prosody_ssml/CS2-32-P2-01_m.mp3", "f": "prosody_ssml/CS2-32-P2-01_f.mp3"}, "CS2-32-P2-02": {"text": "Let us MEET at the OFfice at NINE.", "type": "prosody", "answer": "three-beats", "strategy": "emphasis", "targets": ["meet", "office", "nine"], "expected": "stress", "m": "prosody_ssml/CS2-32-P2-02_m.mp3", "f": "prosody_ssml/CS2-32-P2-02_f.mp3"}, "CS2-35-EY1-01": {"text": "Wadaya gonna do about it?", "type": "prosody", "answer": "eye-dialect-test", "strategy": "eye-dialect-ipa", "targets": [], "expected": "plain", "m": "prosody_ssml/CS2-35-EY1-01_m.mp3", "f": "prosody_ssml/CS2-35-EY1-01_f.mp3"}, "CS2-35-EY1-02": {"text": "Wouldja send me the file?", "type": "prosody", "answer": "eye-dialect-test", "strategy": "eye-dialect-ipa", "targets": [], "expected": "plain", "m": "prosody_ssml/CS2-35-EY1-02_m.mp3", "f": "prosody_ssml/CS2-35-EY1-02_f.mp3"}, "CS2-35-EY1-03": {"text": "Doncha wanna see it first?", "type": "prosody", "answer": "eye-dialect-test", "strategy": "eye-dialect-ipa", "targets": [], "expected": "plain", "m": "prosody_ssml/CS2-35-EY1-03_m.mp3", "f": "prosody_ssml/CS2-35-EY1-03_f.mp3"}, "CS2-35-EY1-04": {"text": "I gotcha covered.", "type": "prosody", "answer": "eye-dialect-test", "strategy": "eye-dialect-ipa", "targets": [], "expected": "plain", "m": "prosody_ssml/CS2-35-EY1-04_m.mp3", "f": "prosody_ssml/CS2-35-EY1-04_f.mp3"}, "CS2-35-EY1-05": {"text": "I hafta finish this.", "type": "prosody", "answer": "eye-dialect-test", "strategy": "eye-dialect-ipa", "targets": [], "expected": "plain", "m": "prosody_ssml/CS2-35-EY1-05_m.mp3", "f": "prosody_ssml/CS2-35-EY1-05_f.mp3"}, "CS2-36-NS1-01": {"text": "I left it on the TAble.", "type": "contrastive_stress", "answer": "last-content-word", "strategy": "emphasis", "targets": ["table"], "expected": "stress", "m": "prosody_ssml/CS2-36-NS1-01_m.mp3", "f": "prosody_ssml/CS2-36-NS1-01_f.mp3"}, "CS2-36-NS1-02": {"text": "She is presenting the results on FRIday.", "type": "contrastive_stress", "answer": "last-content-word", "strategy": "emphasis", "targets": ["friday"], "expected": "stress", "m": "prosody_ssml/CS2-36-NS1-02_m.mp3", "f": "prosody_ssml/CS2-36-NS1-02_f.mp3"}, "CS2-36-NS1-03": {"text": "We need to review the CONtract.", "type": "contrastive_stress", "answer": "last-content-word", "strategy": "emphasis", "targets": ["contract"], "expected": "stress", "m": "prosody_ssml/CS2-36-NS1-03_m.mp3", "f": "prosody_ssml/CS2-36-NS1-03_f.mp3"}, "CS2-36-NS1-04": {"text": "He sent the invoice to the CLIent.", "type": "contrastive_stress", "answer": "last-content-word", "strategy": "emphasis", "targets": ["client"], "expected": "stress", "m": "prosody_ssml/CS2-36-NS1-04_m.mp3", "f": "prosody_ssml/CS2-36-NS1-04_f.mp3"}, "CS2-36-NS2-01": {"text": "I left it on the table for YOU.", "type": "contrastive_stress", "answer": "shifted-to-pronoun", "strategy": "emphasis", "targets": ["you"], "expected": "stress", "m": "prosody_ssml/CS2-36-NS2-01_m.mp3", "f": "prosody_ssml/CS2-36-NS2-01_f.mp3"}, "CS2-36-NS2-02": {"text": "We reviewed the contract THEN.", "type": "contrastive_stress", "answer": "shifted-to-adverb", "strategy": "emphasis", "targets": ["then"], "expected": "stress", "m": "prosody_ssml/CS2-36-NS2-02_m.mp3", "f": "prosody_ssml/CS2-36-NS2-02_f.mp3"}, "CS2-37-GN1-01": {"text": "I bought a new CAR.", "type": "contrastive_stress", "answer": "new-info-car", "strategy": "emphasis", "targets": ["car"], "expected": "stress", "m": "prosody_ssml/CS2-37-GN1-01_m.mp3", "f": "prosody_ssml/CS2-37-GN1-01_f.mp3"}, "CS2-37-GN1-02": {"text": "A RED car.", "type": "contrastive_stress", "answer": "new-info-red", "strategy": "emphasis", "targets": ["red"], "expected": "stress", "m": "prosody_ssml/CS2-37-GN1-02_m.mp3", "f": "prosody_ssml/CS2-37-GN1-02_f.mp3"}, "CS2-37-GN2-01": {"text": "Who sent the report? MARco sent it.", "type": "contrastive_stress", "answer": "new-info-subject", "strategy": "emphasis", "targets": ["marco"], "expected": "stress", "m": "prosody_ssml/CS2-37-GN2-01_m.mp3", "f": "prosody_ssml/CS2-37-GN2-01_f.mp3"}, "CS2-37-GN2-02": {"text": "What did Marco send? He sent the REport.", "type": "contrastive_stress", "answer": "new-info-object", "strategy": "emphasis", "targets": ["report"], "expected": "stress", "m": "prosody_ssml/CS2-37-GN2-02_m.mp3", "f": "prosody_ssml/CS2-37-GN2-02_f.mp3"}, "CS2-37-GN3-01": {"text": "The meeting is on Thursday