rosody", "answer": "two-beats", "v3_prompt": "The Cat Has Been Sitting On The Mat.", "m": "prosody_v3/CS2-32-P1-04_m.mp3", "f": "prosody_v3/CS2-32-P1-04_f.mp3"}, "CS2-32-P1-05": {"text": "BIRDS SING.", "type": "prosody", "answer": "two-beats", "v3_prompt": "Birds Sing.", "m": "prosody_v3/CS2-32-P1-05_m.mp3", "f": "prosody_v3/CS2-32-P1-05_f.mp3"}, "CS2-32-P1-06": {"text": "The BIRDS have been SINGing.", "type": "prosody", "answer": "two-beats", "v3_prompt": "The Birds Have Been Singing.", "m": "prosody_v3/CS2-32-P1-06_m.mp3", "f": "prosody_v3/CS2-32-P1-06_f.mp3"}, "CS2-32-P2-01": {"text": "I NEED to FInish the REport toDAY.", "type": "prosody", "answer": "four-beats", "v3_prompt": "I Need To Finish The Report Today.", "m": "prosody_v3/CS2-32-P2-01_m.mp3", "f": "prosody_v3/CS2-32-P2-01_f.mp3"}, "CS2-32-P2-02": {"text": "Let us MEET at the OFfice at NINE.", "type": "prosody", "answer": "three-beats", "v3_prompt": "Let Us Meet At The Office At Nine.", "m": "prosody_v3/CS2-32-P2-02_m.mp3", "f": "prosody_v3/CS2-32-P2-02_f.mp3"}, "CS2-36-NS1-01": {"text": "I left it on the TAble.", "type": "contrastive_stress", "answer": "last-content-word", "v3_prompt": "I Left It On The Table.", "m": "prosody_v3/CS2-36-NS1-01_m.mp3", "f": "prosody_v3/CS2-36-NS1-01_f.mp3"}, "CS2-36-NS1-02": {"text": "She is presenting the results on FRIday.", "type": "contrastive_stress", "answer": "last-content-word", "v3_prompt": "She Is Presenting The Results On Friday.", "m": "prosody_v3/CS2-36-NS1-02_m.mp3", "f": "prosody_v3/CS2-36-NS1-02_f.mp3"}, "CS2-36-NS1-03": {"text": "We need to review the CONtract.", "type": "contrastive_stress", "answer": "last-content-word", "v3_prompt": "We Need To Review The Contract.", "m": "prosody_v3/CS2-36-NS1-03_m.mp3", "f": "prosody_v3/CS2-36-NS1-03_f.mp3"}, "CS2-36-NS1-04": {"text": "He sent the invoice to the CLIent.", "type": "contrastive_stress", "answer": "last-content-word", "v3_prompt": "He Sent The Invoice To The Client.", "m": "prosody_v3/CS2-36-NS1-04_m.mp3", "f": "prosody_v3/CS2-36-NS1-04_f.mp3"}, "CS2-36-NS2-01": {"text": "I left it on the table for YOU.", "type": "contrastive_stress", "answer": "shifted-to-pronoun", "v3_prompt": "I Left It On The Table For You.", "m": "prosody_v3/CS2-36-NS2-01_m.mp3", "f": "prosody_v3/CS2-36-NS2-01_f.mp3"}, "CS2-36-NS2-02": {"text": "We reviewed the contract THEN.", "type": "contrastive_stress", "answer": "shifted-to-adverb", "v3_prompt": "We Reviewed The Contract Then.", "m": "prosody_v3/CS2-36-NS2-02_m.mp3", "f": "prosody_v3/CS2-36-NS2-02_f.mp3"}, "CS2-37-GN1-01": {"text": "I bought a new CAR.", "type": "contrastive_stress", "answer": "new-info-car", "v3_prompt": "I Bought A New Car.", "m": "prosody_v3/CS2-37-GN1-01_m.mp3", "f": "prosody_v3/CS2-37-GN1-01_f.mp3"}, "CS2-37-GN1-02": {"text": "A RED car.", "type": "contrastive_stress", "answer": "new-info-red", "v3_prompt": "A RED Car.", "m": "prosody_v3/CS2-37-GN1-02_m.mp3", "f": "prosody_v3/CS2-37-GN1-02_f.mp3"}, "CS2-37-GN2-01": {"text": "Who sent the report? MARco sent it.", "type": "contrastive_stress", "answer": "new-info-subject", "v3_prompt": "Who Sent The Report? MARCO Sent It.", "m": "prosody_v3/CS2-37-GN2-01_m.mp3", "f": "prosody_v3/CS2-37-GN2-01_f.mp3"}, "CS2-37-GN2-02": {"text": "What did Marco send? He sent the REport.", "type": "contrastive_stress", "answer": "new-info-object", "v3_prompt": "What Did Marco Send? He Sent The Report.", "m": "prosody_v3/CS2-37-GN2-02_m.mp3", "f": "prosody_v3/CS2-37-GN2-02_f.mp3"}, "CS2-37-GN3-01": {"text": "The meeting is on Thursday at THREE.", "type": "contrastive_stress", "answer": "new-info-time", "v3_prompt": "The Meeting Is On Thursday At Three.", "m": "prosody_v3/CS2-37-GN3-01_m.mp3", "f": "prosody_v3/CS2-37-GN3-01_f.mp3"}, "CS2-37-GN3-02": {"text": "The MEETing is on Thursday, not the call.", "type": "contrastive_stress", "answer": "new-info-subject", "v3_prompt": "The MEETING Is On Thursday, Not The Call.", "m": "prosody_v3/CS2-37-GN3-02_m.mp3", "f": "prosody_v3/CS2-37-GN3-02_f.m