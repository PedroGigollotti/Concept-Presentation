_v3/CS2-40-IN3-01_f.mp3"}, "CS2-40-IN3-02": {"text": "Nice day, isn't it?", "type": "intonation", "answer": "tag-fall-agreement", "v3_prompt": "Nice Day, Isn't It?", "m": "prosody_v3/CS2-40-IN3-02_m.mp3", "f": "prosody_v3/CS2-40-IN3-02_f.mp3"}, "CS2-40-IN3-03": {"text": "You are the manager, aren't you?", "type": "intonation", "answer": "tag-rise-question", "v3_prompt": "[curious] You Are The Manager, Aren't You?", "m": "prosody_v3/CS2-40-IN3-03_m.mp3", "f": "prosody_v3/CS2-40-IN3-03_f.mp3"}, "CS2-40-IN3-04": {"text": "You did send it, didn't you?", "type": "intonation", "answer": "tag-fall-agreement", "v3_prompt": "You Did Send It, Didn't You?", "m": "prosody_v3/CS2-40-IN3-04_m.mp3", "f": "prosody_v3/CS2-40-IN3-04_f.mp3"}, "CS2-41-CS1-01": {"text": "I didn't say SHE stole the money.", "type": "contrastive_stress", "answer": "she", "v3_prompt": "I Didn't Say SHE Stole The Money.", "m": "prosody_v3/CS2-41-CS1-01_m.mp3", "f": "prosody_v3/CS2-41-CS1-01_f.mp3"}, "CS2-41-CS1-02": {"text": "I didn't SAY she stole the money.", "type": "contrastive_stress", "answer": "say", "v3_prompt": "I Didn't SAY She Stole The Money.", "m": "prosody_v3/CS2-41-CS1-02_m.mp3", "f": "prosody_v3/CS2-41-CS1-02_f.mp3"}, "CS2-41-CS1-03": {"text": "I didn't say she STOLE the money.", "type": "contrastive_stress", "answer": "stole", "v3_prompt": "I Didn't Say She STOLE The Money.", "m": "prosody_v3/CS2-41-CS1-03_m.mp3", "f": "prosody_v3/CS2-41-CS1-03_f.mp3"}, "CS2-41-CS1-04": {"text": "I didn't say she stole the MONEY.", "type": "contrastive_stress", "answer": "money", "v3_prompt": "I Didn't Say She Stole The Money.", "m": "prosody_v3/CS2-41-CS1-04_m.mp3", "f": "prosody_v3/CS2-41-CS1-04_f.mp3"}, "CS2-41-CS1-05": {"text": "I DIDN'T say she stole the money.", "type": "contrastive_stress", "answer": "didnt", "v3_prompt": "I DIDN'T Say She Stole The Money.", "m": "prosody_v3/CS2-41-CS1-05_m.mp3", "f": "prosody_v3/CS2-41-CS1-05_f.mp3"}, "CS2-41-CS2-01": {"text": "I want the RED one, not the blue one."