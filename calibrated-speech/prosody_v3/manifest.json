v3_prompt": "I Ordered A Hot Dog.", "m": "prosody_v3/CS2-23-CS5-01_m.mp3", "f": "prosody_v3/CS2-23-CS5-01_f.mp3"}, "CS2-23-CS5-02": {"text": "I ordered a hot DOG.", "type": "contrastive_stress", "answer": "phrase", "v3_prompt": "I Ordered A Hot Dog.", "m": "prosody_v3/CS2-23-CS5-02_m.mp3", "f": "prosody_v3/CS2-23-CS5-02_f.mp3"}, "CS2-23-CS6-01": {"text": "We met in the DARKroom.", "type": "contrastive_stress", "answer": "compound", "v3_prompt": "We Met In The Darkroom.", "m": "prosody_v3/CS2-23-CS6-01_m.mp3", "f": "prosody_v3/CS2-23-CS6-01_f.mp3"}, "CS2-23-CS6-02": {"text": "We met in the dark ROOM.", "type": "contrastive_stress", "answer": "phrase", "v3_prompt": "We Met In The Dark Room.", "m": "prosody_v3/CS2-23-CS6-02_m.mp3", "f": "prosody_v3/CS2-23-CS6-02_f.mp3"}, "CS2-25-P1-01": {"text": "Please turn it OFF.", "type": "prosody", "answer": "particle", "v3_prompt": "Please Turn It Off.", "m": "prosody_v3/CS2-25-P1-01_m.mp3", "f": "prosody_v3/CS2-25-P1-01_f.mp3"}, "CS2-25-P1-02": {"text": "Could you look it UP?", "type": "prosody", "answer": "particle", "v3_prompt": "Could You Look It Up?", "m": "prosody_v3/CS2-25-P1-02_m.mp3", "f": "prosody_v3/CS2-25-P1-02_f.mp3"}, "CS2-25-P1-03": {"text": "I will pick you UP at eight.", "type": "prosody", "answer": "particle", "v3_prompt": "I Will Pick You UP At Eight.", "m": "prosody_v3/CS2-25-P1-03_m.mp3", "f": "prosody_v3/CS2-25-P1-03_f.mp3"}, "CS2-25-P1-04": {"text": "She turned the offer DOWN.", "type": "prosody", "answer": "particle", "v3_prompt": "She Turned The Offer Down.", "m": "prosody_v3/CS2-25-P1-04_m.mp3", "f": "prosody_v3/CS2-25-P1-04_f.mp3"}, "CS2-25-P1-05": {"text": "We need to sort this OUT.", "type": "prosody", "answer": "particle", "v3_prompt": "We Need To Sort This Out.", "m": "prosody_v3/CS2-25-P1-05_m.mp3", "f": "prosody_v3/CS2-25-P1-05_f.mp3"}, "CS2-25-P2-01": {"text": "She looked at the REport.", "type": "prosody", "answer": "preposition", "v3_prompt": "She Looked At The Report.", "m": "prosody_v3/CS2-25-P2-01_m.mp3", "f": "prosody_v3/CS2-25-P2-01_f.mp3"}, "CS2-25-P2-02": {"text": "He listened to the CLIent.", "type": "prosody", "answer": "preposition", "v3_prompt": "He Listened To The Client.", "m": "prosody_v3/CS2-25-P2-02_m.mp3", "f": "prosody_v3/CS2-25-P2-02_f.mp3"}, "CS2-25-P2-03": {"text": "They agreed with the DEcision.", "type": "prosody", "answer": "preposition", "v3_prompt": "They Agreed With The Decision.", "m": "prosody_v3/CS2-25-P2-03_m.mp3", "f": "prosody_v3/CS2-25-P2-03_f.mp3"}, "CS2-28-P1-01": {"text": "I NEED to GO to the STORE.", "type": "prosody", "answer": "content-strong", "v3_prompt": "I NEED To GO To The Store.", "m": "prosody_v3/CS2-28-P1-01_m.mp3", "f": "prosody_v3/CS2-28-P1-01_f.mp3"}, "CS2-28-P1-02": {"text": "She is the BEST in the CLASS.", "type": "prosody", "answer": "content-strong", "v3_prompt": "She Is The BEST In The Class.", "m": "prosody_v3/CS2-28-P1-02_m.mp3", "f": "prosody_v3/CS2-28-P1-02_f.mp3"}, "CS2-28-P1-03": {"text": "We had a CUP of COFfee.", "type": "prosody", "answer": "content-strong", "v3_prompt": "We Had A CUP Of Coffee.", "m": "prosody_v3/CS2-28-P1-03_m.mp3", "f": "prosody_v3/CS2-28-P1-03_f.mp3"}, "CS2-28-P1-04": {"text": "I WANT to TALK to the MANager.", "type": "prosody", "answer": "content-strong", "v3_prompt": "I WANT To TALK To The Manager.", "m": "prosody_v3/CS2-28-P1-04_m.mp3", "f": "prosody_v3/CS2-28-P1-04_f.mp3"}, "CS2-31-TG1-01": {"text": "When the report is finished... send it to the whole team... not just to me.", "type": "thought_group", "answer": "three-groups", "v3_prompt": "When The Report Is Finished Send It To The Whole Team Not Just To Me.", "m": "prosody_v3/CS2-31-TG1-01_m.mp3", "f": "prosody_v3/CS2-31-TG1-01_f.mp3"}, "CS2-31-TG1-02": {"text": "When the report is finished send it to the whole team not just to me.", "type": "thought_group", "answer": "no-groups", "v3_prompt": "When The Report Is Finished Send It To The Whole Team Not Just To Me.", "m": "prosody_v3/CS2-31-TG1-02_m.mp3", "f": "proso